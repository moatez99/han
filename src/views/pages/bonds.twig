{#
| Hanaya — Bonds collection page (static port of Hanaya Site v3 "Bonds" screen)
|
| NOTE ON ROUTING:
| Salla's page routes are fixed (product/category/cart/single-page); a custom
| `/bonds` route is not natively addable. This template is a self-contained
| static page. To surface it on a real store you can either:
|   (a) paste this markup into a Salla "Single Page" (rendered by page-single.twig), or
|   (b) map it onto the Bonds category page once a Bonds category exists.
| The home "Explore Bonds" link points at `{{ store.url }}/bonds` as a placeholder path.
|
| Header & footer come from the Raed master layout.
| Styles: src/assets/styles/04-components/bonds.scss (scoped to .hanaya-bonds)
| Interactivity: the 6 design tabs switch panels (see inline script at the bottom).
#}
{% extends "layouts.master" %}

{% block content %}
<div class="hanaya-bonds" id="hanaya-bonds">

  {# ═══════════════  Hero  ═══════════════ #}
  <section class="b-hero">
    <img class="b-hero__img" src="{{ 'images/hanaya/bonds-hero.jpg' | asset }}" alt="" aria-hidden="true">
    <div class="b-hero__scrim" aria-hidden="true"></div>
    <div class="b-hero__content">
      <div class="b-hero__eyebrow">The collection</div>
      <h1>Bonds</h1>
      <p class="b-hero__sub">Six designs · Every bond tells a story</p>
    </div>
  </section>

  {# ═══════════════  Inspiration  ═══════════════ #}
  <section class="b-inspiration">
    <div class="b-eyebrow">The inspiration</div>
    <p class="b-inspiration__lead">Inspired by the Sinay-tailed lizard of the Saudi desert — the seamless, steady connection of its rings embodying bonds that combine flexibility and strength.</p>
    <p class="b-inspiration__sub">Six designs, each drawn from a human bond — and within each design, a family of pieces.</p>
  </section>

  {# ═══════════════  Design tabs  ═══════════════ #}
  <div class="b-tabs">
    <div class="b-tabs__track" role="tablist" aria-label="Bonds designs">
      <button class="b-tab is-active" role="tab" aria-selected="true"  aria-controls="panel-trust"        id="tab-trust"        data-panel="panel-trust">
        <span class="b-tab__num">01</span><span class="b-tab__name">Trust</span><span class="b-tab__underline" aria-hidden="true"></span>
      </button>
      <button class="b-tab" role="tab" aria-selected="false" aria-controls="panel-support"      id="tab-support"      data-panel="panel-support">
        <span class="b-tab__num">02</span><span class="b-tab__name">Support</span><span class="b-tab__underline" aria-hidden="true"></span>
      </button>
      <button class="b-tab" role="tab" aria-selected="false" aria-controls="panel-connection"   id="tab-connection"   data-panel="panel-connection">
        <span class="b-tab__num">03</span><span class="b-tab__name">Connection</span><span class="b-tab__underline" aria-hidden="true"></span>
      </button>
      <button class="b-tab" role="tab" aria-selected="false" aria-controls="panel-appreciation" id="tab-appreciation" data-panel="panel-appreciation">
        <span class="b-tab__num">04</span><span class="b-tab__name">Appreciation</span><span class="b-tab__underline" aria-hidden="true"></span>
      </button>
      <button class="b-tab" role="tab" aria-selected="false" aria-controls="panel-devotion"     id="tab-devotion"     data-panel="panel-devotion">
        <span class="b-tab__num">05</span><span class="b-tab__name">Devotion</span><span class="b-tab__underline" aria-hidden="true"></span>
      </button>
      <button class="b-tab" role="tab" aria-selected="false" aria-controls="panel-unity"        id="tab-unity"        data-panel="panel-unity">
        <span class="b-tab__num">06</span><span class="b-tab__name">Unity</span><span class="b-tab__underline" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {# ═══════════════  Panel 01 — Trust (fully designed)  ═══════════════ #}
  <div class="b-panel is-active" id="panel-trust" role="tabpanel" aria-labelledby="tab-trust">
    <section class="b-spotlight">
      <div class="b-spotlight__media"><img src="{{ 'images/hanaya/product-trust-ring.jpg' | asset }}" alt="Bonds Trust"></div>
      <div class="b-spotlight__body">
        <div class="b-spotlight__eyebrow">The design</div>
        <h2>Bonds Trust</h2>
        <div class="b-spotlight__formula">Stability + Certainty = Trust</div>
        <p class="b-spotlight__desc">The first designs of the Bonds Collection, where trust arises from connection — embodying a relationship that grows, strengthens, and endures. Four pieces, each crowned with lab-grown diamonds.</p>
      </div>
    </section>

    <section class="b-products">
      <article class="b-product">
        <div class="b-product__media"><img src="{{ 'images/hanaya/product-trust-pendant.jpg' | asset }}" alt="Trust Pendant"></div>
        <div>
          <div class="b-product__row"><span class="b-product__name">Trust Pendant</span><span class="b-product__price">10,000 SAR</span></div>
          <div class="b-product__status b-product__status--ready">Ready to order</div>
        </div>
      </article>
      <article class="b-product">
        <div class="b-product__media"><img src="{{ 'images/hanaya/product-trust-ring.jpg' | asset }}" alt="Trust Ring"></div>
        <div>
          <div class="b-product__row"><span class="b-product__name">Trust Ring</span><span class="b-product__price">5,000 SAR</span></div>
