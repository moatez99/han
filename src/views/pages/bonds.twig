        </div>
      </article>
      <article class="b-product">
        <div class="b-product__media b-product__media--placeholder"><span>product shot — in photography</span></div>
        <div>
          <div class="b-product__row"><span class="b-product__name">Trust Bracelet</span><span class="b-product__price">7,000 SAR</span></div>
          <div class="b-product__status b-product__status--made">Order to make</div>
        </div>
      </article>
      <article class="b-product">
        <div class="b-product__media"><img src="{{ 'images/hanaya/product-trust-earring.jpg' | asset }}" alt="Trust Earring"></div>
        <div>
          <div class="b-product__row"><span class="b-product__name">Trust Earring</span><span class="b-product__price">4,000 SAR</span></div>
          <div class="b-product__status b-product__status--ready">Ready to order</div>
        </div>
      </article>
    </section>
  </div>

  {# ═══════════════  Panels 02–06 — concept extensions (coming soon)  ═══════════════ #}
  {# Per the v3 design note: only the Trust design exists today; the other five
     tabs remain concept extensions. Each shows a tasteful placeholder. #}
  <div class="b-panel" id="panel-support" role="tabpanel" aria-labelledby="tab-support">
    <section class="b-soon">
      <div class="b-eyebrow">02 · The design</div>
      <div class="b-soon__name">Bonds Support</div>
      <p class="b-soon__note">Presence + Reliance = Support. A concept extension of the Bonds Collection — pieces in development.</p>
      <div class="b-soon__tag">Coming soon</div>
    </section>
  </div>
  <div class="b-panel" id="panel-connection" role="tabpanel" aria-labelledby="tab-connection">
    <section class="b-soon">
      <div class="b-eyebrow">03 · The design</div>
      <div class="b-soon__name">Bonds Connection</div>
      <p class="b-soon__note">Closeness + Continuity = Connection. A concept extension of the Bonds Collection — pieces in development.</p>
      <div class="b-soon__tag">Coming soon</div>
    </section>
  </div>
  <div class="b-panel" id="panel-appreciation" role="tabpanel" aria-labelledby="tab-appreciation">
    <section class="b-soon">
      <div class="b-eyebrow">04 · The design</div>
      <div class="b-soon__name">Bonds Appreciation</div>
      <p class="b-soon__note">Gratitude + Recognition = Appreciation. A concept extension of the Bonds Collection — pieces in development.</p>
      <div class="b-soon__tag">Coming soon</div>
    </section>
  </div>
  <div class="b-panel" id="panel-devotion" role="tabpanel" aria-labelledby="tab-devotion">
    <section class="b-soon">
      <div class="b-eyebrow">05 · The design</div>
      <div class="b-soon__name">Bonds Devotion</div>
      <p class="b-soon__note">Loyalty + Dedication = Devotion. A concept extension of the Bonds Collection — pieces in development.</p>
      <div class="b-soon__tag">Coming soon</div>
    </section>
  </div>
  <div class="b-panel" id="panel-unity" role="tabpanel" aria-labelledby="tab-unity">
    <section class="b-soon">
      <div class="b-eyebrow">06 · The design</div>
      <div class="b-soon__name">Bonds Unity</div>
      <p class="b-soon__note">Togetherness + Harmony = Unity. A concept extension of the Bonds Collection — pieces in development.</p>
      <div class="b-soon__tag">Coming soon</div>
    </section>
  </div>

</div>
{% endblock %}

{% block scripts %}
<script defer src="{{ 'home.js' | asset }}"></script>
<script>
/* Bonds design-tab switcher — self-contained, no bundler dependency.
   Switches the active tab + panel, updates ARIA, supports keyboard arrows,
   and reflects the choice in the URL hash (e.g. #support) for deep-linking. */
(function () {
  var root = document.getElementById('hanaya-bonds');
  if (!root) return;
  var tabs   = Array.prototype.slice.call(root.querySelectorAll('.b-tab'));
  var panels = Array.prototype.slice.call(root.querySelectorAll('.b-panel'));
  if (!tabs.length) return;

  function activate(tab, setHash) {
    if (!tab) return;
    var panelId = tab.getAttribute('data-panel');
    tabs.forEach(function (t) {
      var on = t === tab;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach(function (p) {
      p.classList.toggle('is-active', p.id === panelId);
    });
    if (setHash) {
      var slug = panelId.replace('panel-', '');
      if (history.replaceState) history.replaceState(null, '', '#' + slug);
    }
  }

  tabs.forEach(function (tab, i) {
    tab.addEventListener('click', function () { activate(tab, true); });
    tab.addEventListener('keydown', function (e) {
      var dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      var next = tabs[(i + dir + tabs.length) % tabs.length];
      next.focus();
      activate(next, true);
    });
  });

  /* Deep-link: open the tab named in the URL hash on load (e.g. /bonds#unity) */
  var hash = (window.location.hash || '').replace('#', '');
  if (hash) {
    var target = tabs.filter(function (t) {
      return t.getAttribute('data-panel') === 'panel-' + hash;
    })[0];
    if (target) activate(target, false);
  }
})();
</script>
{% endblock %}
