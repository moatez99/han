{#
| Hanaya header — matches the Hanaya Site v3 design.
| Top black utility bar + main header (hamburger + search, centered logo,
| language / currency / cart). Keeps the functional Salla web components
| (search, cart summary, user menu, localization) so the store still works.
|
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header class="hy-header">

  {# ── Top black utility bar ── #}
  <div class="hy-topbar">
    <div class="hy-topbar__inner">
      <nav class="hy-topbar__group" aria-label="Utility">
        <a href="{{ store.url }}?page=bonds">Our Story</a>
        <span class="hy-topbar__sep" aria-hidden="true">|</span>
        <a href="{{ store.url }}">Privacy Policy</a>
        <span class="hy-topbar__sep" aria-hidden="true">|</span>
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <salla-localization-modal show-trigger></salla-localization-modal>
        {% else %}
          <span>English</span><span class="hy-topbar__sep" aria-hidden="true">|</span><span>Saudi Riyal</span>
        {% endif %}
      </nav>
      <div class="hy-topbar__group">
        {% if store.contacts.phone %}
          <a href="tel:{{ store.contacts.phone }}">{{ store.contacts.phone }}</a>
          <span class="hy-topbar__sep" aria-hidden="true">|</span>
        {% else %}
          <a href="tel:+966505405020">+966 505 40 50 20</a>
          <span class="hy-topbar__sep" aria-hidden="true">|</span>
        {% endif %}
        <a href="mailto:{{ store.contacts.email ?: 'care@hanaya.sa' }}">{{ store.contacts.email ?: 'care@hanaya.sa' }}</a>
      </div>
    </div>
  </div>

  {# ── Main header ── #}
  <div id="mainnav" class="hy-mainnav">
    <div class="hy-mainnav__inner">

      {# left: hamburger + search #}
      <div class="hy-mainnav__left">
        <a class="hy-burger mburger mburger--collapse" href="#mobile-menu" aria-label="Open menu">
          <span></span><span></span><span></span>
        </a>
        <div class="hy-search">
          <salla-search inline oval height="36"></salla-search>
        </div>
      </div>

      {# center: logo #}
      <a class="hy-brand" href="{{ store.url }}" aria-label="{{ store.name }} — home">
        {% if store.logo %}
          <img fetchpriority="high" loading="eager" src="{{ store.logo|cdn(220) }}" alt="{{ store.name }} logo">
        {% else %}
          <span class="hy-brand__text">HANAYA</span>
        {% endif %}
        {% if is_page('index') %}
          <h1 class="sr-only">{{ store.name }}</h1>
        {% else %}
          <h2 class="sr-only">{{ store.name }}</h2>
        {% endif %}
      </a>

      {# right: language / currency / user / cart #}
      <div class="hy-mainnav__right">
        <span class="hy-mainnav__meta">Language: English</span>
        <span class="hy-mainnav__meta">Currency: SAR</span>
        <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
        <salla-cart-summary class="hy-cart">
          <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
        </salla-cart-summary>
      </div>

    </div>
  </div>
</header>
