{#
| Hanaya footer — matches the Hanaya Site v3 design.
| 3 columns: Important Links · centered logo + tagline + CR/VAT · Get in Touch
| (socials + Verified on SBC), then a bottom bar with copyright + payment chips.
| Keeps Salla components (salla-social, salla-payments) for real functionality.
#}
<footer class="hy-footer">
  <div class="hy-footer__main">

    {# ── Column 1: Important Links ── #}
    <div class="hy-footer__col">
      <h3 class="hy-footer__title">Important Links</h3>
      <nav class="hy-footer__links" aria-label="Footer">
        <a href="{{ store.url }}">Boutique</a>
        <a href="{{ store.url }}?page=bonds">Our Story</a>
        <a href="{{ store.url }}">Customer Care</a>
        <a href="{{ store.url }}">Terms &amp; Conditions</a>
        <a href="{{ store.url }}">Privacy Policy</a>
      </nav>
    </div>

    {# ── Column 2: brand + tagline + registrations ── #}
    <div class="hy-footer__col hy-footer__brand">
      <a href="{{ store.url }}" class="hy-footer__logo" aria-label="{{ store.name }}">
        {% if store.logo %}
          <img loading="lazy" src="{{ store.logo|cdn(300) }}" alt="{{ store.name }}">
        {% else %}
          <span class="hy-footer__logo-text">HANAYA</span>
        {% endif %}
      </a>
      <p class="hy-footer__tagline">
        {{ store.description ?: 'Jewellery crafted with precision — carrying meaning, and leaving an unforgettable impression.' }}
      </p>
      <div class="hy-reg-row">
        <div class="hy-reg">
          <div class="hy-reg__meta">
            <span class="hy-reg__label">Commercial Register</span>
            <span class="hy-reg__val">1010663952</span>
          </div>
        </div>
        {% if store.settings.tax.number %}
        <div class="hy-reg">
          <img src="{{ 'images/hanaya/vat-badge.png' | asset }}" alt="" aria-hidden="true" width="30" height="38">
          <div class="hy-reg__meta">
            <span class="hy-reg__label">VAT Account Number</span>
            <span class="hy-reg__val">{{ store.settings.tax.number }}</span>
          </div>
        </div>
        {% else %}
        <div class="hy-reg">
          <img src="{{ 'images/hanaya/vat-badge.png' | asset }}" alt="" aria-hidden="true" width="30" height="38">
          <div class="hy-reg__meta">
            <span class="hy-reg__label">VAT Account Number</span>
            <span class="hy-reg__val">300052504300003</span>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    {# ── Column 3: Get in Touch ── #}
    <div class="hy-footer__col">
      <h3 class="hy-footer__title">Get in Touch</h3>
      <div class="hy-socials">
        <salla-social></salla-social>
      </div>
      <div class="hy-sbc-badge">Verified on SBC</div>
    </div>

  </div>

  {# ── Bottom bar ── #}
  <div class="hy-footer__bar">
    <span class="hy-footer__copy">{% hook copyright %}Copyright | 2026 {{ store.name ?: 'Hanaya Jewellery' }}</span>
    <div class="hy-pay">
      <salla-payments></salla-payments>
    </div>
  </div>
</footer>
